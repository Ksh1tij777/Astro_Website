# Firebase Admin SDK (Project Settings -> Service Accounts -> Generate new private key)
#
# RECOMMENDED: base64-encode the whole downloaded JSON file into one var —
# this avoids every newline/quoting problem that raw PEM-in-an-env-var hits
# in web UIs like Vercel's. Generate it with:
#   macOS/Linux:  base64 -i serviceAccountKey.json | tr -d '\n'
#   Windows PS :  [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Fallback (only used if FIREBASE_SERVICE_ACCOUNT_BASE64 is not set):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin dashboard (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Coordinate puzzle answer (server-only)
COORD_RA=10H 45M
COORD_LAT=26.936339
COORD_LNG=75.923260
